# Sufra — frontend env (Vite exposes only VITE_-prefixed vars to the client)
# Copy to .env.local and fill in. .env* is gitignored.

# Public (client-safe) keys — wired up in the backend phase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAPBOX_TOKEN=

# Default merchant slug used when subdomain resolution can't be done (dev/preview)
VITE_DEFAULT_MERCHANT_SLUG=sufra
