    "i18next": "^23.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
